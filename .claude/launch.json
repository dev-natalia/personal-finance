{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "--directory",
        "backend",
        "run",
        "uvicorn",
        "--factory",
        "app.main:create_app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "app",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "--directory",
        "backend",
        "run",
        "uvicorn",
        "--factory",
        "app.main:create_app",
        "--port",
        "8001"
      ],
      "env": {
        "FRONTEND_DIST": "../frontend/dist",
        "APP_ORIGIN": "http://localhost:8001"
      },
      "port": 8001
    }
  ]
}
