{
  "name": "personal-finance-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && vite build",
    "api:types": "uv --directory ../backend run python scripts/export_openapi.py > openapi.json && openapi-typescript openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/recursive": "^5.3.0",
    "@tanstack/react-query": "^5.104.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
